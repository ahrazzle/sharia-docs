{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahrazzle.github.io/sharia-docs/schemas/rule-pack-v1.schema.json",
  "title": "Sharia-Compliance Workbook — Rule Pack v1 (LOCKED schema)",
  "description": "Deterministic offline rule pack. The engine asserts this schema, then the semantic policy checks S1-S7 in validate.py. Canonical hash: sha256 over RFC 8785-style canonical JSON (UTF-8, sorted object keys, no insignificant whitespace, separators ','/':') of the entire pack object. The pack never contains its own hash.",
  "type": "object",
  "required": ["pack_id", "schema_version", "pack_version", "created_utc", "status", "engine_min_version", "domains", "lexicon", "citations", "unverified_sources", "rules"],
  "additionalProperties": false,
  "properties": {
    "pack_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "schema_version": { "const": "1.1.0" },
    "pack_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "created_utc": { "type": "string", "format": "date-time" },
    "status": { "enum": ["draft", "stable", "retired"] },
    "engine_min_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "domains": { "type": "array", "items": { "$ref": "#/$defs/domain" }, "minItems": 1, "maxItems": 16 },
    "lexicon": { "type": "array", "items": { "$ref": "#/$defs/lexicon_entry" }, "minItems": 1 },
    "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" }, "minItems": 1 },
    "unverified_sources": {
      "type": "array",
      "description": "Denormalized registry of every citation whose status is 'unverified'. Must match exactly (semantic check S4).",
      "items": {
        "type": "object",
        "required": ["citation_id", "reason"],
        "additionalProperties": false,
        "properties": {
          "citation_id": { "type": "string", "pattern": "^cit-[a-z0-9-]{1,63}$" },
          "reason": { "type": "string", "minLength": 8 }
        }
      }
    },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" }, "minItems": 1 }
  },
  "$defs": {
    "localized": {
      "description": "Bilingual field. 'ar' is RTL; stored in logical order, never reordered by the engine. null 'ar' is an honest gap rendered by the UX lane.",
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ar": { "type": ["string", "null"] }
      }
    },
    "domain": {
      "type": "object",
      "required": ["domain_id", "label"],
      "additionalProperties": false,
      "properties": {
        "domain_id": { "type": "string", "pattern": "^d_[a-z][a-z0-9_]{2,31}$" },
        "label": { "$ref": "#/$defs/localized" },
        "required_fields": {
          "type": "array",
          "description": "Guided-form worksheet fields the engine treats as mandatory. A confirmed item missing any of them resolves to verdict 'insufficient_input'.",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" }
        }
      }
    },
    "lexicon_entry": {
      "type": "object",
      "required": ["term_id", "en", "ar", "domain_ids"],
      "additionalProperties": false,
      "properties": {
        "term_id": { "type": "string", "pattern": "^term-[a-z0-9-]{1,63}$" },
        "en": { "type": "string", "minLength": 1 },
        "ar": { "type": "string", "minLength": 1, "description": "Arabic surface form(s), NFC-normalized, logical order." },
        "transliteration": { "type": "string" },
        "definition": { "$ref": "#/$defs/localized" },
        "domain_ids": { "type": "array", "items": { "type": "string", "pattern": "^d_[a-z][a-z0-9_]{2,31}$" }, "minItems": 1 },
        "citation_ids": { "type": "array", "items": { "type": "string", "pattern": "^cit-[a-z0-9-]{1,63}$" } }
      }
    },
    "citation": {
      "type": "object",
      "required": ["citation_id", "status", "title", "url", "fetch_date"],
      "additionalProperties": false,
      "allOf": [ { "if": { "properties": { "status": { "const": "verified" } } },
                   "then": { "required": ["sha256", "quote", "quote_sha256"] } } ],
      "properties": {
        "citation_id": { "type": "string", "pattern": "^cit-[a-z0-9-]{1,63}$" },
        "status": {
          "enum": ["verified", "unverified"],
          "description": "verified = primary source fetched by the research lane on fetch_date (sha256 optional but recorded when available). unverified = secondary reference, contested provenance, or text not fetched from its primary authority. ONLY 'verified' citations can back a rule with outcome 'non_compliant' (semantic check S1/S2)."
        },
        "title": { "type": "string", "minLength": 3 },
        "url": { "type": "string", "format": "uri" },
        "fetch_date": { "type": "string", "format": "date" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "quote": { "type": "string", "minLength": 1 },
        "quote_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "note": { "type": "string" }
      }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "term_ids"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "term" },
            "term_ids": { "type": "array", "items": { "type": "string", "pattern": "^term-[a-z0-9-]{1,63}$" }, "minItems": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "pattern"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "regex" },
            "pattern": { "type": "string", "minLength": 1 },
            "flags": { "enum": ["", "i", "u", "iu"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "field"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "field_empty" },
            "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" }
          }
        },
        {
          "type": "object",
          "required": ["type", "field", "equals"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "field_value" },
            "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
            "equals": { "type": ["string", "boolean", "number"] }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["rule_id", "domain_ids", "outcome", "severity", "trigger", "rationale", "citation_ids", "status"],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": "string", "pattern": "^rule-[a-z0-9-]{1,63}$" },
        "domain_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^d_[a-z][a-z0-9_]{2,31}$" },
          "minItems": 1,
          "description": "Domains the rule is evaluated against. A rule fires on an item when the item's domain_id is in this list and the trigger matches." 
        },
        "outcome": {
          "enum": ["non_compliant", "doubtful"],
          "description": "The verdict token this rule contributes when it fires. 'compliant' is never a rule outcome: it is derived by the engine as the absence state (all applicable rules evaluated, none fired, inputs sufficient). 'out_of_coverage' and 'insufficient_input' are engine-level states, never rule outcomes."
        },
        "severity": { "enum": ["blocking", "advisory"] },
        "trigger": { "$ref": "#/$defs/trigger" },
        "rationale": { "$ref": "#/$defs/localized" },
        "citation_ids": { "type": "array", "items": { "type": "string", "pattern": "^cit-[a-z0-9-]{1,63}$" }, "minItems": 1 },
        "status": { "enum": ["active", "retired"] }
      }
    }
  }
}
